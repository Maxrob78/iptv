{
  "name": "iptv-netflix",
  "version": "1.0.0",
  "main": "main/main.js",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build && next export",
    "start": "next start -p 3001",
    "electron": "wait-on tcp:3001 && electron .",
    "dev:app": "concurrently \"npm run dev\" \"npm run electron\"",
    "build:electron": "npm run build && electron-builder"
  },
  "dependencies": {
    "@noriginmedia/norigin-spatial-navigation": "^3.1.0",
    "artplayer": "^5.4.0",
    "autoprefixer": "^10.4.7",
    "electron-updater": "^6.8.9",
    "hls.js": "^1.6.16",
    "localforage": "^1.10.0",
    "mpegts.js": "^1.8.0",
    "next": "^12.3.4",
    "node-mpv": "^1.5.0",
    "opensubtitles-api": "^5.1.2",
    "postcss": "^8.4.14",
    "qrcode.react": "^4.2.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "tailwindcss": "3.1.8",
    "video.js": "^7.21.0",
    "ws": "^8.20.0",
    "zustand": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^16.18.3",
    "@types/react": "^17.0.45",
    "@types/react-dom": "^19.2.3",
    "@types/video.js": "^7.3.58",
    "concurrently": "^7.4.0",
    "electron": "^21.0.0",
    "electron-builder": "^23.6.0",
    "typescript": "^4.8.4",
    "wait-on": "^6.0.1"
  },
  "build": {
    "appId": "com.iptv.netflix",
    "files": [
      "main/**/*",
      "out/**/*"
    ],
    "directories": {
      "buildResources": "resources"
    }
  }
}
